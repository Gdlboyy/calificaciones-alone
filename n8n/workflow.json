    {
      "id": "a1b2c3d4-0021-4aaa-8aaa-000000000021",
      "parameters": {
        "jsCode": "const authHeader = $('Webhook Generar Reporte').first().json.headers?.authorization || $('Webhook Generar Reporte').first().json.headers?.Authorization || '';\nconst token = authHeader.replace(/^Bearer\\s+/i, '').trim();\nconst GOOGLE_CLIENT_ID = 'GOOGLE_CLIENT_ID_AQUI';\n\nif (!token) {\n  return [{ json: { autorizado: false, motivo: 'Falta iniciar sesión' } }];\n}\n\nlet info;\ntry {\n  info = await this.helpers.httpRequest({\n    method: 'GET',\n    url: 'https://oauth2.googleapis.com/tokeninfo',\n    qs: { id_token: token },\n    json: true,\n    ignoreHttpStatusErrors: true,\n  });\n} catch (e) {\n  return [{ json: { autorizado: false, motivo: 'No se pudo validar la sesión' } }];\n}\n\nif (!info || info.error) {\n  return [{ json: { autorizado: false, motivo: 'Sesión inválida o expirada' } }];\n}\nif (info.aud !== GOOGLE_CLIENT_ID) {\n  return [{ json: { autorizado: false, motivo: 'Sesión no corresponde a esta aplicación' } }];\n}\nif (info.email_verified !== 'true' && info.email_verified !== true) {\n  return [{ json: { autorizado: false, motivo: 'Correo no verificado' } }];\n}\n\nconst lista = $input.all().map(i => String(i.json.EMAIL || '').trim().toLowerCase());\nconst email = String(info.email || '').toLowerCase();\nif (!lista.includes(email)) {\n  return [{ json: { autorizado: false, motivo: 'Esta cuenta no está autorizada', email } }];\n}\n\nreturn [{ json: { autorizado: true, email } }];"
      },
